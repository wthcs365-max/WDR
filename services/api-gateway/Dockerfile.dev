FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
COPY tsconfig*.json ./
COPY packages/ packages/
COPY services/api-gateway/ services/api-gateway/
RUN npm install
EXPOSE $(node -e "console.log(require('./services/api-gateway/src/config').config.port || 4000)")
CMD ["npx", "ts-node", "--watch", "services/api-gateway/src/index.ts"]
