FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
COPY tsconfig*.json ./
COPY packages/ packages/
COPY services/trust-service/ services/trust-service/
RUN npm install
EXPOSE $(node -e "console.log(require('./services/trust-service/src/config').config.port || 4000)")
CMD ["npx", "ts-node", "--watch", "services/trust-service/src/index.ts"]
