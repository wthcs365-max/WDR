FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
COPY tsconfig*.json ./
COPY packages/ packages/
COPY services/ledger-service/ services/ledger-service/
RUN npm install
EXPOSE $(node -e "console.log(require('./services/ledger-service/src/config').config.port || 4000)")
CMD ["npx", "ts-node", "--watch", "services/ledger-service/src/index.ts"]
